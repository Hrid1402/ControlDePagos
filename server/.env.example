DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/control_pagos
TEST_DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/control_pagos_test
REDIS_URL=redis://localhost:6379/0
JWT_SECRET=cambiar-esta-clave-cambiar-esta-clave
JWT_EXPIRES_MINUTES=30
LOGIN_INTENTOS_MAXIMOS=5
LOGIN_MINUTOS_BLOQUEO=15
TIMEZONE=America/Lima
CORS_ORIGINS=["http://localhost:5173"]

SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM=no-responder@controldepagos.local
SMTP_USER=
SMTP_PASSWORD=
SMTP_TLS=false

S3_ENDPOINT=http://localhost:8333
S3_REGION=us-east-1
S3_BUCKET=control-pagos
S3_ACCESS_KEY=dev
S3_SECRET_KEY=devsecret

# Comando pnpm init:gerente (ver server/README.md). Las lee del entorno de la sesión, no de este
# archivo: no guardes aquí la contraseña. Sin GERENTE_CONTRASENA, el comando la pide sin eco.
# GERENTE_USERNAME=
# GERENTE_CONTRASENA=
# GERENTE_NOMBRES=
# GERENTE_APELLIDOS=
# GERENTE_CORREO=
