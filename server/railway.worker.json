{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "Dockerfile",
    "watchPatterns": [
      "/server/**"
    ]
  },
  "deploy": {
    "startCommand": "celery -A app.workers.celery_app:celery_app worker -Q general --concurrency=2 --loglevel=INFO",
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10,
    "drainingSeconds": 100
  }
}
