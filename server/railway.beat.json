{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "Dockerfile",
    "watchPatterns": [
      "/server/**"
    ]
  },
  "deploy": {
    "startCommand": "celery -A app.workers.celery_app:celery_app beat --schedule=/tmp/celerybeat-schedule --loglevel=INFO",
    "numReplicas": 1,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10,
    "overlapSeconds": 0
  }
}
